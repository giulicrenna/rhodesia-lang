// libs/flash/missing/isna.rho
// isna(df)        -> df de bools (1 = missing)
// isna_col(df, col) -> vec de 0/1
// notna(df) / notna_col(df, col) -> inversa

// _is_missing_value(df, col, row) — 1 si la celda está marcada como NA.
fun _is_missing_value(record: df, str: col, int: row) -> int {
    record: c = mapping.get(df._cols, col)
    arr: na = c.na
    if row < array.size(na) and na[row] == "1" { return 1 }
    // fallback (mask vacía): para cols str, detectar "" como missing.
    if c.kind == "arr" {
        arr: a = c.data
        if row >= array.size(a) { return 1 }
        if string.length(a[row]) == 0 { return 1 }
    }
    return 0
}

fun isna(record: df) -> record {
    record: out = _new_df()
    int: i = 0
    int: nn = array.size(df._names)
    while i < nn {
        str: nm = df._names[i]
        vec: mask = math.zeros(df._nrows)
        int: r = 0
        while r < df._nrows {
            if _is_missing_value(df, nm, r) == 1 { mask[r] = 1.0 }
            r = r + 1
        }
        out = _set_col(out, nm, _wrap_vec(mask), "bool")
        i = i + 1
    }
    return out
}

fun isna_col(record: df, str: col) -> vec {
    _check_col(df, col)
    vec: mask = math.zeros(df._nrows)
    int: r = 0
    while r < df._nrows {
        if _is_missing_value(df, col, r) == 1 { mask[r] = 1.0 }
        r = r + 1
    }
    return mask
}

fun notna(record: df) -> record {
    record: out = _new_df()
    int: i = 0
    int: nn = array.size(df._names)
    while i < nn {
        str: nm = df._names[i]
        vec: mask = math.zeros(df._nrows)
        int: r = 0
        while r < df._nrows {
            if _is_missing_value(df, nm, r) == 0 { mask[r] = 1.0 }
            r = r + 1
        }
        out = _set_col(out, nm, _wrap_vec(mask), "bool")
        i = i + 1
    }
    return out
}

fun notna_col(record: df, str: col) -> vec {
    _check_col(df, col)
    vec: mask = math.zeros(df._nrows)
    int: r = 0
    while r < df._nrows {
        if _is_missing_value(df, col, r) == 0 { mask[r] = 1.0 }
        r = r + 1
    }
    return mask
}