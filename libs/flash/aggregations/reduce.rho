// libs/flash/aggregations/reduce.rho
// Reducciones por columna: col_sum, col_mean, col_std, col_min, col_max, col_median
// Todas operan sobre una sola columna numérica (lanza error si es string).
// Las celdas con NA se SALTEAN (skipna implícito).

// _na_mask(df, col) — devuelve el arr<str> na de la col (o arr lleno de "0" si no hay).
fun _na_mask(record: df, str: col) -> arr {
    record: c = mapping.get(df._cols, col)
    return c.na
}

// _present(v, na) — cuenta celdas no-NA en v.
fun _present(vec: v, arr: na) -> int {
    int: n = math.size(v)
    int: nn = array.size(na)
    int: k = 0
    int: i = 0
    int: cnt = 0
    if nn < n { k = nn
    cnt = n - nn }
    // celdas sin máscara (cuando nn < n) se consideran presentes.
    while i < k {
        if na[i] == "0" { cnt = cnt + 1 }
        i = i + 1
    }
    while i < n {
        cnt = cnt + 1
        i = i + 1
    }
    return cnt
}

fun col_sum(record: df, str: col) -> float64 {
    vec: v = _get_vec(df, col)
    arr: na = _na_mask(df, col)
    int: n = math.size(v)
    float64: s = 0.0
    int: i = 0
    while i < n {
        if i >= array.size(na) or na[i] == "0" {
            s = s + v[i]
        }
        i = i + 1
    }
    return s
}

fun col_mean(record: df, str: col) -> float64 {
    vec: v = _get_vec(df, col)
    arr: na = _na_mask(df, col)
    int: n = math.size(v)
    int: cnt = _present(v, na)
    if cnt == 0 { return 0.0 }
    float64: s = 0.0
    int: i = 0
    while i < n {
        if i >= array.size(na) or na[i] == "0" {
            s = s + v[i]
        }
        i = i + 1
    }
    return s / cnt
}

fun col_min(record: df, str: col) -> float64 {
    vec: v = _get_vec(df, col)
    arr: na = _na_mask(df, col)
    int: n = math.size(v)
    int: found = 0
    float64: m = 0.0
    int: i = 0
    while i < n {
        if i >= array.size(na) or na[i] == "0" {
            if found == 0 {
                m = v[i]
                found = 1
            } else if v[i] < m {
                m = v[i]
            }
        }
        i = i + 1
    }
    if found == 0 { return 0.0 }
    return m
}

fun col_max(record: df, str: col) -> float64 {
    vec: v = _get_vec(df, col)
    arr: na = _na_mask(df, col)
    int: n = math.size(v)
    int: found = 0
    float64: m = 0.0
    int: i = 0
    while i < n {
        if i >= array.size(na) or na[i] == "0" {
            if found == 0 {
                m = v[i]
                found = 1
            } else if v[i] > m {
                m = v[i]
            }
        }
        i = i + 1
    }
    if found == 0 { return 0.0 }
    return m
}

fun col_std(record: df, str: col) -> float64 {
    vec: v = _get_vec(df, col)
    arr: na = _na_mask(df, col)
    int: n = math.size(v)
    int: cnt = _present(v, na)
    if cnt < 2 { return 0.0 }
    float64: mu = col_mean(df, col)
    float64: s2 = 0.0
    int: i = 0
    while i < n {
        if i >= array.size(na) or na[i] == "0" {
            float64: d = v[i] - mu
            s2 = s2 + d * d
        }
        i = i + 1
    }
    return math.sqrt(s2 / (cnt - 1))
}

fun col_var(record: df, str: col) -> float64 {
    vec: v = _get_vec(df, col)
    arr: na = _na_mask(df, col)
    int: n = math.size(v)
    int: cnt = _present(v, na)
    if cnt < 2 { return 0.0 }
    float64: mu = col_mean(df, col)
    float64: s2 = 0.0
    int: i = 0
    while i < n {
        if i >= array.size(na) or na[i] == "0" {
            float64: d = v[i] - mu
            s2 = s2 + d * d
        }
        i = i + 1
    }
    return s2 / (cnt - 1)
}

fun col_median(record: df, str: col) -> float64 {
    vec: v = _get_vec(df, col)
    arr: na = _na_mask(df, col)
    int: n = math.size(v)
    int: cnt = _present(v, na)
    if cnt == 0 { return 0.0 }
    // copia filtrada (sin NA) y bubble sort
    vec: s = math.zeros(cnt)
    int: j = 0
    int: i = 0
    while i < n {
        if i >= array.size(na) or na[i] == "0" {
            s[j] = v[i]
            j = j + 1
        }
        i = i + 1
    }
    int: swapped = 1
    while swapped == 1 {
        swapped = 0
        i = 0
        while i < cnt - 1 {
            if s[i] > s[i + 1] {
                float64: t = s[i]
                s[i] = s[i + 1]
                s[i + 1] = t
                swapped = 1
            }
            i = i + 1
        }
    }
    int: mid = _flash_intify(cnt / 2)
    if cnt - 2 * mid == 1 {
        return (s[mid - 1] + s[mid]) / 2.0
    }
    return s[mid]
}

// Versión vectorial (sum sobre todo el df) — devuelve vec con un valor por columna numérica.
fun col_sum_all(record: df) -> vec {
    int: nn = array.size(df._names)
    int: num_n = 0
    int: i = 0
    while i < nn {
        str: dt = mapping.get(df._dtypes, df._names[i])
        if dt != "str" { num_n = num_n + 1 }
        i = i + 1
    }
    vec: out = math.zeros(num_n)
    int: k = 0
    i = 0
    while i < nn {
        str: nm = df._names[i]
        str: dt = mapping.get(df._dtypes, nm)
        if dt != "str" {
            out[k] = col_sum(df, nm)
            k = k + 1
        }
        i = i + 1
    }
    return out
}