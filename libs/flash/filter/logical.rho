// libs/flash/filter/logical.rho
// Filtros lógicos: and, or, not entre DataFrames.
// IMPORTANTE: en este esquema cada filter_*() devuelve un df nuevo, pero
// filter_and/filter_or/filter_not operan sobre los MÁSCARAS que subyacen.
// Para no requerir que el usuario guarde máscaras, hacemos:
//   - filter_and(df1, df2)  = intersección de filas de df1 y df2 (asume mismo orden)
//   - filter_or(df1, df2)   = unión (concatenación)
//   - filter_not(df, df_full) = filas de df_full que NO están en df
//
// Esto es semánticamente razonable para un primer cut.

// _row_signature(df, row) — firma string única de una fila (concat valores).
fun _row_signature(record: df, int: row) -> str {
    str: sig = ""
    int: i = 0
    int: n = array.size(df._names)
    while i < n {
        sig = string.concat(sig, _cell_to_display(df, df._names[i], row))
        sig = string.concat(sig, "|")
        i = i + 1
    }
    return sig
}

fun filter_and(record: df1, record: df2) -> record {
    if df1._ncols != df2._ncols {
        _err("filter_and: schemas differ in column count")
    }
    // Asumimos mismo esquema. Intersección: filas de df1 cuya firma esté en df2.
    arr: sigs2 = array.create(0)
    int: i = 0
    while i < df2._nrows {
        array.push(sigs2, _row_signature(df2, i))
        i = i + 1
    }
    arr: mask = array.create(0)
    i = 0
    while i < df1._nrows {
        str: s = _row_signature(df1, i)
        if _arr_contains(sigs2, s) == 1 { array.push(mask, 1) }
        else { array.push(mask, 0) }
        i = i + 1
    }
    return _apply_filter(df1, mask)
}

fun filter_or(record: df1, record: df2) -> record {
    if df1._ncols != df2._ncols {
        _err("filter_or: schemas differ in column count")
    }
    // Concatenar: filas de df1 + filas de df2 cuya firma NO esté en df1
    arr: sigs1 = array.create(0)
    int: i = 0
    while i < df1._nrows {
        array.push(sigs1, _row_signature(df1, i))
        i = i + 1
    }
    arr: extra_rows = array.create(0)
    i = 0
    while i < df2._nrows {
        str: s = _row_signature(df2, i)
        if _arr_contains(sigs1, s) == 0 { array.push(extra_rows, i) }
        i = i + 1
    }
    // Construir df: todas las filas de df1 + las extra de df2
    int: total = df1._nrows + array.size(extra_rows)
    record: out = _empty_df_like(df1)
    int: nn = array.size(df1._names)
    int: k = 0
    int: ci = 0
    while ci < nn {
        str: nm = df1._names[ci]
        str: dt = mapping.get(df1._dtypes, nm)
        record: c1 = mapping.get(df1._cols, nm)
        record: c2 = mapping.get(df2._cols, nm)
        if c1.kind == "arr" {
            arr: a1 = c1.data
            arr: a2 = c2.data
            arr: out_a = array.create(0)
            int: r = 0
            while r < df1._nrows {
                array.push(out_a, a1[r])
                r = r + 1
            }
            int: e = 0
            while e < array.size(extra_rows) {
                array.push(out_a, a2[extra_rows[e]])
                e = e + 1
            }
            out = _set_col(out, nm, _wrap_arr(out_a), dt)
        } else {
            vec: v1 = c1.data
            vec: v2 = c2.data
            vec: out_v = math.zeros(total)
            int: r = 0
            while r < df1._nrows {
                out_v[r] = v1[r]
                r = r + 1
            }
            int: e = 0
            while e < array.size(extra_rows) {
                out_v[df1._nrows + e] = v2[extra_rows[e]]
                e = e + 1
            }
            out = _set_col(out, nm, _wrap_vec(out_v), dt)
        }
        ci = ci + 1
    }
    return out
}

fun filter_not(record: full, record: sub) -> record {
    if full._ncols != sub._ncols {
        _err("filter_not: schemas differ in column count")
    }
    arr: subsigs = array.create(0)
    int: i = 0
    while i < sub._nrows {
        array.push(subsigs, _row_signature(sub, i))
        i = i + 1
    }
    arr: mask = array.create(0)
    i = 0
    while i < full._nrows {
        if _arr_contains(subsigs, _row_signature(full, i)) == 1 {
            array.push(mask, 0)
        } else {
            array.push(mask, 1)
        }
        i = i + 1
    }
    return _apply_filter(full, mask)
}

fun _arr_contains(arr: a, str: x) -> int {
    int: i = 0
    int: n = array.size(a)
    while i < n {
        if a[i] == x { return 1 }
        i = i + 1
    }
    return 0
}

// filter_complement(df, cond) — alias mnemónico de filter_not (filas en df que NO están en cond).
// Más legible en pipelines: filter_complement(df, filter_eq(df, "x", 1)) == filter_not(filter_eq(...)).
fun filter_complement(record: full, record: cond) -> record {
    return filter_not(full, cond)
}

// ponytail: Rhodesia no soporta `~` como operador unario, así que el
// "NOT" se obtiene con filter_not(df, sub) o filter_complement(df, sub).
// Para invertir UNA comparación puntual, usar filter_ne(df, col, val).