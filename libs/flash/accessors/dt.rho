// dt_dayofweek(df, col) — 0=lunes, 6=domingo. Algoritmo: Zeller o Gauss.
fun dtc_dayofweek(record: df, str: col) -> record {
    _check_col(df, col)
    record: c = mapping.get(df._cols, col)
    if c.kind != "arr" { _err("dt_dayofweek: must be string/datetime") }
    arr: a = c.data
    arr: na = c.na
    int: n = array.size(a)
    vec: out = math.zeros(n)
    int: i = 0
    while i < n {
        str: v = a[i]
        if string.length(v) >= 10 {
            int: y = _intify_f(_str_to_int_safe(string.slice(v, 0, 4)))
            int: m = _intify_f(_str_to_int_safe(string.slice(v, 5, 7)))
            int: d = _intify_f(_str_to_int_safe(string.slice(v, 8, 10)))
            out[i] = _dow(y, m, d) * 1.0
        }
        i = i + 1
    }
    str: new_name = string.concat(col, "_dow")
    return _set_col(df, new_name, { kind: "vec", data: out, na: na }, "int")
}

// _dow(y, m, d) — día de la semana 0=lun..6=dom (algoritmo de Zeller simplificado).
// Trabaja con float64 internamente y trunca a int al final.
fun _dow(int: y, int: m, int: d) -> int {
    float64: yf = y * 1.0
    float64: mf = m * 1.0
    float64: df = d * 1.0
    if mf < 3.0 { mf = mf + 12.0
    yf = yf - 1.0 }
    float64: k = yf - math.floor(yf / 100.0) * 100.0
    float64: j = math.floor(yf / 100.0)
    float64: h = df + (13.0 * (mf + 1.0)) / 5.0 + k + math.floor(k / 4.0) + math.floor(j / 4.0) - 2.0 * j
    h = h - math.floor(h / 7.0) * 7.0
    int: hi = _intify_f(h)
    if hi < 0 { hi = hi + 7 }
    if hi == 0 { return 5 }
    if hi == 1 { return 6 }
    if hi == 2 { return 0 }
    if hi == 3 { return 1 }
    if hi == 4 { return 2 }
    if hi == 5 { return 3 }
    return 4
}

fun dtc_hour(record: df, str: col) -> record {
    _check_col(df, col)
    record: c = mapping.get(df._cols, col)
    if c.kind != "arr" { _err("dt_hour: must be string/datetime") }
    arr: a = c.data
    arr: na = c.na
    int: n = array.size(a)
    vec: out = math.zeros(n)
    int: i = 0
    while i < n {
        str: v = a[i]
        if string.length(v) >= 13 { out[i] = _str_to_int_safe(string.slice(v, 11, 13)) }
        i = i + 1
    }
    str: new_name = string.concat(col, "_hour")
    return _set_col(df, new_name, { kind: "vec", data: out, na: na }, "int")
}

