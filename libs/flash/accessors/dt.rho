// libs/flash/accessors/dt.rho
// Datetime accessors a nivel de columna. Equivalente a pandas `.dt`.
//
// Las columnas datetime se almacenan como arr<str> en formato ISO
// "YYYY-MM-DD" o "YYYY-MM-DD HH:MM:SS". No usamos el record {year,..} de
// Rhodesia para mantener la simplicidad columnar y compatibilidad con CSV.
//
// API:
//   dt_year(df, col)             -> df con nueva col "<col>_year"    (int vec)
//   dt_month(df, col)            -> df con nueva col "<col>_month"   (int vec)
//   dt_day(df, col)              -> df con nueva col "<col>_day"     (int vec)
//   dt_dayofweek(df, col)        -> df con nueva col "<col>_dow"     (int vec 0=lun,6=dom)
//   dt_hour(df, col)             -> df con nueva col "<col>_hour"    (int vec, 0 si solo fecha)
//   dt_minute(df, col)           -> df con nueva col "<col>_minute"  (int vec)
//   dt_second(df, col)           -> df con nueva col "<col>_second"  (int vec)
//   dt_format(df, col, fmt)      -> df con col reformateada (usa datetime.format internamente)
//   dt_to_timestamp(df, col)     -> df con nueva col "<col>_ts" (float64 unix ts)
//   dt_diff_days(df, col1, col2) -> df con nueva col "<col1>_minus_<col2>_days"
//   dt_parse(df, col)            -> df con col parseada a ISO "YYYY-MM-DD" (no-op si ya lo es)
//
// ponytail: usamos operaciones de string para extraer componentes. datetime.format
// requiere un record {year,..}, así que construimos uno por celda — lento.

fun dtc_year(record: df, str: col) -> record {
    _check_col(df, col)
    record: c = mapping.get(df._cols, col)
    if c.kind != "arr" { _err("dt_year: must be string/datetime") }
    arr: a = c.data
    arr: na = c.na
    int: n = array.size(a)
    vec: out = math.zeros(n)
    int: i = 0
    while i < n {
        str: v = a[i]
        if string.length(v) >= 4 { out[i] = _str_to_int_safe(string.slice(v, 0, 4)) }
        i = i + 1
    }
    str: new_name = string.concat(col, "_year")
    return _set_col(df, new_name, { kind: "vec", data: out, na: na }, "int")
}

fun dtc_month(record: df, str: col) -> record {
    _check_col(df, col)
    record: c = mapping.get(df._cols, col)
    if c.kind != "arr" { _err("dt_month: must be string/datetime") }
    arr: a = c.data
