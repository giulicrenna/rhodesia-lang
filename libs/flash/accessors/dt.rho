    if c.kind != "arr" { _err("dt_second: must be string/datetime") }
    arr: a = c.data
    arr: na = c.na
    int: n = array.size(a)
    vec: out = math.zeros(n)
    int: i = 0
    while i < n {
        str: v = a[i]
        if string.length(v) >= 19 { out[i] = _str_to_int_safe(string.slice(v, 17, 19)) }
        i = i + 1
    }
    str: new_name = string.concat(col, "_second")
    return _set_col(df, new_name, { kind: "vec", data: out, na: na }, "int")
