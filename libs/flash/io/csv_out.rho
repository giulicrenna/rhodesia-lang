// libs/flash/io/csv_out.rho
// DataFrame → CSV file.
//
// API:
//   write_csv(df, path)              -> int (bytes escritos)
//   write_csv_sep(df, path, sep)     -> int
//   to_csv(df)                       -> str
//   to_csv_sep(df, sep)              -> str

// _csv_escape(s) — escapa comillas y envuelve en comillas si contiene sep/comilla/newline.
fun _csv_escape(str: s, str: sep) -> str {
    int: n = string.length(s)
    int: needs_quote = 0
    int: i = 0
    while i < n {
        str: c = string.slice(s, i, i + 1)
        if c == "\"" or c == "\n" or c == "\r" { needs_quote = 1 }
        else if string.length(sep) == 1 and c == sep { needs_quote = 1 }
        i = i + 1
    }
    if needs_quote == 0 { return s }
    // Duplicar comillas internas y envolver
    str: out = "\""
    i = 0
    while i < n {
        str: c = string.slice(s, i, i + 1)
        if c == "\"" {
            out = string.concat(out, "\"\"")
        } else {
            out = string.concat(out, c)
        }
        i = i + 1
    }
    out = string.concat(out, "\"")
    return out
}

// _float_to_str(x) — float a string (formato corto).
fun _float_to_str(float64: x) -> str {
    if x < 0.0 { return string.concat("-", _float_to_str(-x)) }
    int: ip = _flash_intify(x)
    float64: frac = x - ip
    // redondeo a 6 decimales
    float64: scaled = frac * 1000000.0 + 0.5
    int: iscaled = _flash_intify(scaled)
    if iscaled >= 1000000 { ip = ip + 1
    iscaled = 0 }
    if iscaled == 0 { return _int_str(ip) }
    // pad iscaled to 6 digits
    str: fstr = _int_str(iscaled)
    while string.length(fstr) < 6 { fstr = string.concat("0", fstr) }
    // strip trailing zeros
    while string.length(fstr) > 1 and string.slice(fstr, string.length(fstr) - 1, string.length(fstr)) == "0" {
        fstr = string.slice(fstr, 0, string.length(fstr) - 1)
    }
    return string.concat(string.concat(_int_str(ip), "."), fstr)
}

// _cell_to_str(df, col_name, row) — convierte una celda a string para CSV.
fun _cell_to_str(record: df, str: col, int: row) -> str {
    _check_col(df, col)
    record: c = mapping.get(df._cols, col)
    if c.kind == "arr" {
        arr: a = c.data
        if row >= array.size(a) { return "" }
        return a[row]
    }
    vec: v = c.data
    if row >= math.size(v) { return "" }
    return _float_to_str(v[row])
}

// to_csv_sep(df, sep) — genera el contenido CSV como string.
fun to_csv_sep(record: df, str: sep) -> str {
    str: out = ""
    // header
    int: i = 0
    int: n = array.size(df._names)
    while i < n {
        if i > 0 { out = string.concat(out, sep) }
        out = string.concat(out, _csv_escape(df._names[i], sep))
        i = i + 1
    }
    out = string.concat(out, "\n")
    // filas
    int: r = 0
    while r < df._nrows {
        i = 0
        while i < n {
            if i > 0 { out = string.concat(out, sep) }
            out = string.concat(out, _csv_escape(_cell_to_str(df, df._names[i], r), sep))
            i = i + 1
        }
        out = string.concat(out, "\n")
        r = r + 1
    }
    return out
}

fun to_csv(record: df) -> str {
    return to_csv_sep(df, ",")
}

fun write_csv_sep(record: df, str: path, str: sep) -> int {
    str: content = to_csv_sep(df, sep)
    return io.write_file(path, content)
}

fun write_csv(record: df, str: path) -> int {
    return write_csv_sep(df, path, ",")
}