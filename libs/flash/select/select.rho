// libs/flash/select/select.rho
// select_cols(df, names) — devuelve df con sólo las columnas indicadas.
// Las columnas aparecen en el orden dado.

fun select_cols(record: df, arr: names) -> record {
    record: out = _new_df()
    int: i = 0
    int: n = array.size(names)
    while i < n {
        str: nm = names[i]
        _check_col(df, nm)
        record: c = mapping.get(df._cols, nm)
        str: dt = mapping.get(df._dtypes, nm)
        out = _set_col(out, nm, c, dt)
        i = i + 1
    }
    return out
}

// select_one(df, name) — atajo para un solo nombre.
fun select_one(record: df, str: name) -> record {
    return select_cols(df, [name])
}

// reorder(df, names) — reordena columnas (todas deben existir).
fun reorder(record: df, arr: names) -> record {
    int: n = array.size(names)
    int: dfn = df._ncols
    if n != dfn {
        _err(string.concat("reorder: expected ",
                            _int_str(dfn), " names, got ",
                            _int_str(n)))
    }
    record: out = _new_df()
    int: i = 0
    while i < n {
        str: nm = names[i]
        _check_col(df, nm)
        record: c = mapping.get(df._cols, nm)
        str: dt = mapping.get(df._dtypes, nm)
        out = _set_col(out, nm, c, dt)
        i = i + 1
    }
    return out
}