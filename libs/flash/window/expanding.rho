// libs/flash/window/expanding.rho
// expanding_mean(df, col) -> vec
// expanding_sum(df, col) -> vec
// expanding_std(df, col) -> vec

fun expanding_mean(record: df, str: col) -> vec {
    vec: v = _get_vec(df, col)
    int: n = math.size(v)
    vec: out = math.zeros(n)
    float64: s = 0.0
    int: i = 0
    while i < n {
        s = s + v[i]
        out[i] = s / (i + 1)
        i = i + 1
    }
    return out
}

fun expanding_sum(record: df, str: col) -> vec {
    vec: v = _get_vec(df, col)
    int: n = math.size(v)
    vec: out = math.zeros(n)
    float64: s = 0.0
    int: i = 0
    while i < n {
        s = s + v[i]
        out[i] = s
        i = i + 1
    }
    return out
}

fun expanding_std(record: df, str: col) -> vec {
    vec: v = _get_vec(df, col)
    int: n = math.size(v)
    vec: out = math.zeros(n)
    if n < 2 { return out }
    float64: s = 0.0
    float64: s2 = 0.0
    int: i = 0
    while i < n {
        s = s + v[i]
        s2 = s2 + v[i] * v[i]
        float64: mean = s / (i + 1)
        float64: var = s2 / (i + 1) - mean * mean
        if var < 0.0 { var = 0.0 }
        if i < 1 { out[i] = 0.0 }
        else { out[i] = math.sqrt(var * (i + 1) / i) }
        i = i + 1
    }
    return out
}