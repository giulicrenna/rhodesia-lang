// series/heatmap.rho - Heatmap series: 2D grid of colored rects.
// Data shape: rows is an arr of vec, each vec = one row of cell values.
// ponytail: Rhodesia doesn't allow m[r][c] = v assignment, so the example
// pushes row-vecs into an arr. The renderer walks arr[i][j].

fun heatmap(arr: rows, arr: row_labels, arr: col_labels, str: label) -> int {
    map: s = mapping.create()
    mapping.put(s, "kind", "heatmap")
    mapping.put(s, "rows", rows)
    mapping.put(s, "row_labels", row_labels)
    mapping.put(s, "col_labels", col_labels)
    mapping.put(s, "label", label)
    array.push(_cur_series(), s)
    return 0
}

fun _heatmap_dims(map: s) -> vec {
    arr: rows = mapping.get(s, "rows")
    int: nrows = array.size(rows)
    int: ncols = 0
    if nrows > 0 { ncols = math.size(rows[0]) }
    vec: d = [nrows, ncols]
    return d
}

fun _heatmap_value(arr: rows, int: r, int: c) -> float64 {
    vec: row = rows[r]
    return row[c]
}

fun _heatmap_min(map: s) -> float64 {
    arr: rows = mapping.get(s, "rows")
    int: nrows = array.size(rows)
    if nrows < 1 { return 0.0 }
    vec: row0 = rows[0]
    int: ncols = math.size(row0)
    float64: mn = row0[0]
    int: r = 0
    while r < nrows {
        vec: rr = rows[r]
        int: c = 0
        while c < ncols {
            if rr[c] < mn { mn = rr[c] }
            c = c + 1
        }
        r = r + 1
    }
    return mn
}

fun _heatmap_max(map: s) -> float64 {
    arr: rows = mapping.get(s, "rows")
    int: nrows = array.size(rows)
    if nrows < 1 { return 0.0 }
    vec: row0 = rows[0]
    int: ncols = math.size(row0)
    float64: mx = row0[0]
    int: r = 0
    while r < nrows {
        vec: rr = rows[r]
        int: c = 0
        while c < ncols {
            if rr[c] > mx { mx = rr[c] }
            c = c + 1
        }
        r = r + 1
    }
    return mx
}