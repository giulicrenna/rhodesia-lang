{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./out",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true
  },
  "include": [
    "extension.js",
    "server/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "out",
    "**/*.test.js",
    "**/*.json"
  ]
}
