{
  "name": "RhodesiaLanguage",
  "displayName": "Rhodesia Language Support",
  "description": "Comprehensive language support for Rhodesia (.rho files) including syntax highlighting, intelligent autocomplete, linting, hover documentation, code navigation, formatting and semantic highlighting",
  "version": "0.1.3",
  "publisher": "GiulianoCrenna",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Languages",
    "Programming Languages",
    "Data Science"
  ],
  "keywords": [
    "rhodesia",
    "rho",
    "data science",
    "programming language",
    "mathematics",
    "linear algebra",
    "scientific computing"
  ],
  "main": "./extension.js",
  "icon": "lang_icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "qna": "https://github.com/giulicrenna/rhodesia-lang/discussions",
  "markdown": "github",
  "contributes": {
    "languages": [
      {
        "id": "rhodesia",
        "aliases": [
          "Rhodesia",
          "rho"
        ],
        "extensions": [
          ".rho"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./lang_icon.png",
          "dark": "./lang_icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "rhodesia",
        "scopeName": "source.rho",
        "path": "./syntaxes/rhodesia.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "rhodesia.showInfo",
        "title": "Rhodesia: Show Extension Info"
      }
    ],
    "snippets": [
      {
        "language": "rhodesia",
        "path": "./snippets/rho.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "function",
        "superType": null,
        "description": "Function declarations and calls"
      },
      {
        "id": "variable",
        "superType": null,
        "description": "Variable references"
      },
      {
        "id": "parameter",
        "superType": null,
        "description": "Function parameters"
      },
      {
        "id": "type",
        "superType": null,
        "description": "Rhodesia type names"
      },
      {
        "id": "namespace",
        "superType": null,
        "description": "Module names in qualified access"
      },
      {
        "id": "constant",
        "superType": null,
        "description": "Constant declarations"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "declaration",
        "description": "Symbol is a declaration"
      },
      {
        "id": "readonly",
        "description": "Symbol cannot be reassigned"
      }
    ],
    "configuration": {
      "title": "Rhodesia",
      "properties": {
        "rhodesia.enableLinting": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable linting for Rhodesia files"
        },
        "rhodesia.enableAutocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable autocomplete for Rhodesia files"
        },
        "rhodesia.showTypeHints": {
          "type": "boolean",
          "default": true,
          "description": "Show type hints on hover"
        },
        "rhodesia.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of problems shown by the linter"
        },
        "rhodesia.formatter.indentSize": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Number of spaces per indentation level used by the formatter"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo 'no-op: source is JS, no build step'"
  },
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/giulicrenna/rhodesia-lang.git"
  },
  "bugs": {
    "url": "https://github.com/giulicrenna/rhodesia-lang/issues"
  },
  "homepage": "https://github.com/giulicrenna/rhodesia-lang/blob/main/extension/README.md",
  "license": "MIT",
  "author": {
    "name": "Giuliano Crenna",
    "email": "giulicrenna@gmail.com"
  },
  "publishConfig": {
    "access": "public"
  }
}
