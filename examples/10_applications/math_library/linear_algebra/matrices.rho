// matrices.rho
// Advanced matrix operations beyond built-in functions

// Matrix trace (sum of diagonal elements)
fun mat_trace(mat: m) -> float64 {
    int: n = min(rows(m), cols(m))
    float64: trace = 0.0

    for i in range(n) {
        trace = trace + m[i, i]
    }

    return trace
}

// Matrix determinant (2x2 case)
fun mat_det_2x2(mat: m) -> float64 {
    return m[0, 0] * m[1, 1] - m[0, 1] * m[1, 0]
}

// Matrix determinant (3x3 case)
fun mat_det_3x3(mat: m) -> float64 {
    float64: a = m[0, 0] * (m[1, 1] * m[2, 2] - m[1, 2] * m[2, 1])
    float64: b = m[0, 1] * (m[1, 0] * m[2, 2] - m[1, 2] * m[2, 0])
    float64: c = m[0, 2] * (m[1, 0] * m[2, 1] - m[1, 1] * m[2, 0])
    return a - b + c
}

// Matrix transpose
fun mat_transpose(mat: m) -> mat {
    int: rows_m = rows(m)
    int: cols_m = cols(m)
    // transposed shape is (cols_m × rows_m), not (rows_m × cols_m)
    mat: result = zeros(cols_m, rows_m)

    for i in range(rows_m) {
        for j in range(cols_m) {
            result[j, i] = m[i, j]
        }
    }

    return result
}

// Matrix element-wise multiplication (Hadamard product)
fun mat_hadamard(mat: a, mat: b) -> mat {
    int: rows_a = rows(a)
    int: cols_a = cols(a)
    mat: result = zeros(rows_a, cols_a)

    for i in range(rows_a) {
        for j in range(cols_a) {
            result[i, j] = a[i, j] * b[i, j]
        }
    }

    return result
}

// Matrix element-wise division
fun mat_divide(mat: a, mat: b) -> mat {
    int: rows_a = rows(a)
    int: cols_a = cols(a)
    mat: result = zeros(rows_a, cols_a)

    for i in range(rows_a) {
        for j in range(cols_a) {
            result[i, j] = safe_divide(a[i, j], b[i, j])
        }
    }

    return result
}

// Matrix Frobenius norm
fun mat_frobenius_norm(mat: m) -> float64 {
    int: rows_m = rows(m)
    int: cols_m = cols(m)
    float64: sum_squares = 0.0

    for i in range(rows_m) {
        for j in range(cols_m) {
            sum_squares = sum_squares + m[i, j] * m[i, j]
        }
    }

    return sqrt(sum_squares)
}

// Matrix maximum norm (max absolute value)
fun mat_max_norm(mat: m) -> float64 {
    int: rows_m = rows(m)
    int: cols_m = cols(m)
    float64: max_val = 0.0

    for i in range(rows_m) {
        for j in range(cols_m) {
            float64: abs_val = abs(m[i, j])
            if abs_val > max_val {
                max_val = abs_val
            }
        }
    }

    return max_val
}

// Matrix is square
fun mat_is_square(mat: m) -> bool {
    return rows(m) == cols(m)
}

// Matrix is symmetric (within epsilon)
fun mat_is_symmetric(mat: m, float64: epsilon) -> bool {
    if not mat_is_square(m) {
        return false
    }

    int: n = rows(m)

    for i in range(n) {
        for j in range(i + 1, n) {
            float64: diff = abs(m[i, j] - m[j, i])
            if diff > epsilon {
                return false
            }
        }
    }

    return true
}

// Matrix is diagonal (within epsilon)
fun mat_is_diagonal(mat: m, float64: epsilon) -> bool {
    if not mat_is_square(m) {
        return false
    }

    int: n = rows(m)

    for i in range(n) {
        for j in range(n) {
            if i != j {
                if abs(m[i, j]) > epsilon {
                    return false
                }
            }
        }
    }

    return true
}

// Matrix is identity (within epsilon)
fun mat_is_identity(mat: m, float64: epsilon) -> bool {
    if not mat_is_square(m) {
        return false
    }

    int: n = rows(m)

    for i in range(n) {
        for j in range(n) {
            if i == j {
                if abs(m[i, j] - 1.0) > epsilon {
                    return false
                }
            } else {
                if abs(m[i, j]) > epsilon {
                    return false
                }
            }
        }
    }

    return true
}

// Matrix outer product of two vectors
fun mat_outer_product(vec: u, vec: v) -> mat {
    int: m = size(u)
    int: n = size(v)
    mat: result = zeros(m, n)

    for i in range(m) {
        for j in range(n) {
            result[i, j] = u[i] * v[j]
        }
    }

    return result
}

// Matrix element-wise absolute value
fun mat_abs(mat: m) -> mat {
    int: rows_m = rows(m)
    int: cols_m = cols(m)
    mat: result = zeros(rows_m, cols_m)

    for i in range(rows_m) {
        for j in range(cols_m) {
            result[i, j] = abs(m[i, j])
        }
    }

    return result
}

// Matrix element-wise clamp
fun mat_clamp(mat: m, float64: min_val, float64: max_val) -> mat {
    int: rows_m = rows(m)
    int: cols_m = cols(m)
    mat: result = zeros(rows_m, cols_m)

    for i in range(rows_m) {
        for j in range(cols_m) {
            result[i, j] = clamp(m[i, j], min_val, max_val)
        }
    }

    return result
}

// Matrix row means
fun mat_row_means(mat: m) -> vec {
    int: rows_m = rows(m)
    int: cols_m = cols(m)
    vec: means = zeros(rows_m)

    for i in range(rows_m) {
        float64: row_sum = 0.0
        for j in range(cols_m) {
            row_sum = row_sum + m[i, j]
        }
        means[i] = row_sum / cols_m
    }

    return means
}

// Matrix column means
fun mat_col_means(mat: m) -> vec {
    int: rows_m = rows(m)
    int: cols_m = cols(m)
    vec: means = zeros(cols_m)

    for j in range(cols_m) {
        float64: col_sum = 0.0
        for i in range(rows_m) {
            col_sum = col_sum + m[i, j]
        }
        means[j] = col_sum / rows_m
    }

    return means
}

// Matrix row sums
fun mat_row_sums(mat: m) -> vec {
    int: rows_m = rows(m)
    int: cols_m = cols(m)
    vec: sums = zeros(rows_m)

    for i in range(rows_m) {
        float64: row_sum = 0.0
        for j in range(cols_m) {
            row_sum = row_sum + m[i, j]
        }
        sums[i] = row_sum
    }

    return sums
}

// Matrix column sums
fun mat_col_sums(mat: m) -> vec {
    int: rows_m = rows(m)
    int: cols_m = cols(m)
    vec: sums = zeros(cols_m)

    for j in range(cols_m) {
        float64: col_sum = 0.0
        for i in range(rows_m) {
            col_sum = col_sum + m[i, j]
        }
        sums[j] = col_sum
    }

    return sums
}

// Matrix diagonal extraction
fun mat_diagonal(mat: m) -> vec {
    int: n = min(rows(m), cols(m))
    vec: diag = zeros(n)

    for i in range(n) {
        diag[i] = m[i, i]
    }

    return diag
}

// Matrix from diagonal vector
fun mat_from_diagonal(vec: diag) -> mat {
    int: n = size(diag)
    mat: result = zeros(n, n)

    for i in range(n) {
        result[i, i] = diag[i]
    }

    return result
}

// Matrix block extraction
fun mat_block(mat: m, int: start_row, int: start_col, int: block_rows, int: block_cols) -> mat {
    mat: block = zeros(block_rows, block_cols)

    for i in range(block_rows) {
        for j in range(block_cols) {
            block[i, j] = m[start_row + i, start_col + j]
        }
    }

    return block
}
