
float64: time = get_tick()
println("Linear Regression with Rhodesia")
println("")

// Design matrix X (20x4)
// Columns: [Intercept, Linear_X1, Quadratic_X1, Factor_X2]
mat: X = [
    [1.0, 1.0, 1.0, 10.5], [1.0, 2.0, 4.0, 11.2], [1.0, 3.0, 9.0, 10.8],
    [1.0, 4.0, 16.0, 12.1], [1.0, 5.0, 25.0, 11.5], [1.0, 6.0, 36.0, 13.0],
    [1.0, 7.0, 49.0, 12.8], [1.0, 8.0, 64.0, 14.2], [1.0, 9.0, 81.0, 13.5],
    [1.0, 10.0, 100.0, 15.1], [1.0, 11.0, 121.0, 14.8], [1.0, 12.0, 144.0, 16.2],
    [1.0, 13.0, 169.0, 15.7], [1.0, 14.0, 196.0, 17.1], [1.0, 15.0, 225.0, 16.5],
    [1.0, 16.0, 256.0, 18.0], [1.0, 17.0, 289.0, 17.4], [1.0, 18.0, 324.0, 19.3],
    [1.0, 19.0, 361.0, 18.9], [1.0, 20.0, 400.0, 20.2]
]

// Response vector y (20x1)
// Modelized as: y = 5 + 1.2*x1 + 0.05*x1^2 + 0.8*x2 + noise
vec: y = [
    14.8, 16.2, 17.5, 20.1, 21.4, 24.8, 26.3, 30.1, 31.5, 36.2,
    37.8, 42.5, 44.1, 49.3, 51.2, 57.1, 59.5, 66.4, 69.2, 75.8
]
println("Design Matrix X:")
println(X)
println("")
println("Response vector y:")
println(y)
println("")

// OLS Estimator: β = (X'X)^(-1) X'y
fun ols_fit(mat: X, vec: y) -> vec {
    mat: xt = math.transpose(X)
    mat: xtx = xt * X
    mat: xtx_inv = math.inv(xtx)
    vec: xty = xt * y
    vec: beta = xtx_inv * xty
    return beta
}

// Compute coefficients
vec: beta = ols_fit(X, y)

println("OLS Results")
println("Intercept (beta_0):", beta[0])
println("Slope (beta_1):    ", beta[1])
println("")

// Compute predictions
vec: y_pred = X * beta

println("Predictions")
println("Actual     Predicted")
for i in range(math.size(y)) {
    print(y[i])
    print("       ")
    println(y_pred[i])
}
println("")

// R-squared calculation
float64: y_mean = stats.mean(y)
vec: residuals = y - y_pred
vec: y_centered = y - y_mean * math.ones(math.size(y))

float64: ss_res = math.dot(residuals, residuals)
float64: ss_tot = math.dot(y_centered, y_centered)
float64: r_squared = 1.0 - ss_res / ss_tot

println("Model Quality")
println("Sum of Squared Residuals:", ss_res)
println("Total Sum of Squares:    ", ss_tot)
println("R-squared:               ", r_squared)
println("")

// RMSE
float64: rmse = math.sqrt(ss_res / math.size(y))
println("RMSE:                    ", rmse)

float64: end_time = get_tick()

println("")
println("Execution Time: ", end_time - time, " seconds")