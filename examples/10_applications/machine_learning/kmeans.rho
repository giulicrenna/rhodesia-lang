
println("K-means Clustering with Rhodesia")
println("")

/*
 1. DATA GENERATION - Create synthetic 2D data points
*/
println("1. Data Generation")

// Generate 3 clusters of 2D points
// Cluster 1: Around (2, 2)
mat: cluster1 = [
    [2.1, 1.9],
    [2.3, 2.2],
    [1.8, 2.1],
    [2.0, 2.0],
    [2.2, 1.8]
]

// Cluster 2: Around (8, 8)
mat: cluster2 = [
    [8.1, 8.2],
    [7.9, 7.8],
    [8.3, 8.1],
    [7.8, 8.0],
    [8.2, 7.9]
]

// Cluster 3: Around (5, 12)
mat: cluster3 = [
    [5.1, 12.2],
    [4.9, 11.8],
    [5.2, 12.1],
    [5.0, 11.9],
    [4.8, 12.0]
]

// Combine all points into one dataset
mat: X = [
    [2.1, 1.9],
    [2.3, 2.2],
    [1.8, 2.1],
    [2.0, 2.0],
    [2.2, 1.8],
    [8.1, 8.2],
    [7.9, 7.8],
    [8.3, 8.1],
    [7.8, 8.0],
    [8.2, 7.9],
    [5.1, 12.2],
    [4.9, 11.8],
    [5.2, 12.1],
    [5.0, 11.9],
    [4.8, 12.0]
]

int: n_samples = math.rows(X)
int: n_features = math.cols(X)

print("Generated dataset with ")
print(n_samples)
print(" samples and ")
print(n_features)
println(" features")
println("")

/*
 2. K-MEANS ALGORITHM
*/
println("2. K-means Clustering")

// Parameters
int: k = 3          // Number of clusters
int: max_iter = 100 // Maximum iterations
float64: tol = 0.001 // Tolerance for convergence

// Helper function to print a row of a matrix
fun print_row(mat: m, int: row_idx) -> void {
    int: n_cols = math.cols(m)
    print("[")
    for j in range(n_cols) {
        if j > 0 {
            print(", ")
        }
        print(m[row_idx, j])
    }
    print("]")
}

// Function to calculate Euclidean distance between two matrix rows
fun euclidean_distance_rows(mat: data1, int: row1, mat: data2, int: row2) -> float64 {
    float64: sum = 0.0
    int: n_features = math.cols(data1)

    for j in range(n_features) {
        float64: diff = data1[row1, j] - data2[row2, j]
        sum = sum + diff * diff
    }

    return math.sqrt(sum)
}

// Function to initialize centroids using matrix slicing
fun initialize_centroids(mat: data, int: k) -> mat {
    // Create centroids matrix by selecting first k rows
    int: n_features = math.cols(data)
    mat: centroids = math.zeros(k, n_features)

    // Copy first k rows from data to centroids element by element
    for i in range(k) {
        for j in range(n_features) {
            centroids[i, j] = data[i, j]
        }
    }

    return centroids
}

// Function to assign each point to nearest centroid
fun assign_clusters(mat: data, mat: centroids) -> vec {
    int: n = math.rows(data)
    int: k = math.rows(centroids)
    vec: clusters = math.zeros(n)

    for i in range(n) {
        float64: min_dist = 999999.0
        float64: best_cluster = 0.0

        for j in range(k) {
            float64: dist = euclidean_distance_rows(data, i, centroids, j)

            if dist < min_dist {
                min_dist = dist
                float64: j_float = j
                best_cluster = j_float
            }
        }

        clusters[i] = best_cluster
    }

    return clusters
}

// Function to update centroids as mean of assigned points
fun update_centroids(mat: data, vec: clusters, int: k) -> mat {
    int: n_features = math.cols(data)
    mat: new_centroids = math.zeros(k, n_features)
    vec: counts = math.zeros(k)

    // Accumulate sums for each cluster element by element
    for i in range(math.rows(data)) {
        // Get cluster assignment (will be 0.0, 1.0, or 2.0)
        // We need to work with it as int for indexing
        // So we'll handle each cluster explicitly
        float64: cluster_val = clusters[i]

        // Check which cluster and accumulate
        if cluster_val == 0.0 {
            counts[0] = counts[0] + 1.0
            for j in range(n_features) {
                new_centroids[0, j] = new_centroids[0, j] + data[i, j]
            }
        } else if cluster_val == 1.0 {
            counts[1] = counts[1] + 1.0
            for j in range(n_features) {
                new_centroids[1, j] = new_centroids[1, j] + data[i, j]
            }
        } else if cluster_val == 2.0 {
            counts[2] = counts[2] + 1.0
            for j in range(n_features) {
                new_centroids[2, j] = new_centroids[2, j] + data[i, j]
            }
        }
    }

    // Calculate mean for each cluster
    for i in range(k) {
        if counts[i] > 0.0 {
            for j in range(n_features) {
                new_centroids[i, j] = new_centroids[i, j] / counts[i]
            }
        }
    }

    return new_centroids
}

// Function to check convergence
fun has_converged(mat: old_centroids, mat: new_centroids, float64: tol) -> bool {
    float64: total_change = 0.0

    for i in range(math.rows(old_centroids)) {
        float64: dist = euclidean_distance_rows(old_centroids, i, new_centroids, i)
        total_change = total_change + dist
    }

    return total_change < tol
}

/*
 3. RUN K-MEANS
*/
println("3. Running K-means")

// Initialize centroids
mat: centroids = initialize_centroids(X, k)
vec: clusters = math.zeros(math.rows(X))

println("Initial centroids:")
for i in range(k) {
    print("  Cluster ")
    print(i)
    print(": ")
    print_row(centroids, i)
    println("")
}
println("")

// Main loop
int: iter = 0
bool: converged = false

while iter < max_iter and not converged {
    // Store old centroids for convergence check
    mat: old_centroids = centroids

    // Assign clusters
    clusters = assign_clusters(X, centroids)

    // Update centroids
    centroids = update_centroids(X, clusters, k)

    // Check convergence
    converged = has_converged(old_centroids, centroids, tol)

    iter = iter + 1
}

print("Converged after ")
print(iter)
println(" iterations")
println("")

/*
 4. RESULTS
*/
println("4. Clustering Results")

println("Final centroids:")
for i in range(k) {
    print("  Cluster ")
    print(i)
    print(": ")
    print_row(centroids, i)
    println("")
}
println("")

println("Cluster assignments:")
for i in range(n_samples) {
    print("  Point ")
    print(i)
    print(": ")
    print_row(X, i)
    print(" -> Cluster ")
    println(clusters[i])
}
println("")

/*
 5. EVALUATION
*/
println("5. Cluster Evaluation")

// Calculate Within-Cluster Sum of Squares (WCSS)
fun calculate_wcss(mat: data, vec: clusters, mat: centroids) -> float64 {
    float64: wcss = 0.0

    for i in range(math.rows(data)) {
        float64: cluster_val = clusters[i]

        // Calculate distance based on cluster assignment
        float64: dist = 0.0
        if cluster_val == 0.0 {
            dist = euclidean_distance_rows(data, i, centroids, 0)
        } else if cluster_val == 1.0 {
            dist = euclidean_distance_rows(data, i, centroids, 1)
        } else if cluster_val == 2.0 {
            dist = euclidean_distance_rows(data, i, centroids, 2)
        }

        wcss = wcss + dist * dist
    }

    return wcss
}

float64: wcss = calculate_wcss(X, clusters, centroids)
print("Within-Cluster Sum of Squares (WCSS): ")
println(wcss)
println("")

// Calculate average distance to centroid
float64: avg_dist = wcss / n_samples
print("Average distance to centroid: ")
println(avg_dist)
println("")

