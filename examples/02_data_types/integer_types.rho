println("Testing New Integer Types")

// Integer types
int8: x8 = 127
int16: x16 = 32767
int32: x32 = 2147483647
uint8: u8 = 255
uint16: u16 = 65535
uint32: u32 = 4294967295
// Note: uint64 max value is too large for current parser
uint64: u64 = 1000000000
byte: b = 255

println("int8: ", x8)
println("int16: ", x16)
println("int32: ", x32)
println("uint8: ", u8)
println("uint16: ", u16)
println("uint32: ", u32)
println("uint64: ", u64)
println("byte: ", b)

