// Operadores Bitwise en Rhodesia
// Soportados en: int, int8..uint64, byte, bool

println("Operadores Bitwise")
println()

println("--- AND (&) ---")
int: a = 12   // 1100
int: b = 10   //  1010
int: and_result = a & b
println("12 & 10 = ", and_result)   // 1000 = 8

int: mask = 255    // 0xFF
int: valor = 305   // 0x131
int: low_byte = valor & mask
println("305 & 255 = ", low_byte)   // 49 (byte bajo)
println()

println("--- OR (|) ---")
int: flags = 0
int: FLAG_READ    = 1   // 001
int: FLAG_WRITE   = 2   // 010
int: FLAG_EXEC    = 4   // 100

flags = FLAG_READ | FLAG_WRITE
println("READ | WRITE = ", flags)   // 3

flags = flags | FLAG_EXEC
println("+ EXEC = ", flags)         // 7
println()

println("--- XOR (^) ---")
int: x = 10   // 1010 en binario
int: y = 12   // 1100 en binario
int: xor_result = x ^ y
println("10 ^ 12 (1010 ^ 1100) = ", xor_result)  // 0110 = 6

// XOR con sí mismo siempre da 0
int: zero = x ^ x
println("x ^ x = ", zero)

// XOR como intercambio sin variable temporal
int: p = 42
int: q = 99
p = p ^ q
q = p ^ q
p = p ^ q
println("swap(42, 99) -> p=", p, " q=", q)
println()

println("--- NOT (~) ---")
int: n = 5
int: not_n = ~n
println("~5 = ", not_n)          // -6  (complemento a 2)

int: u = 170   // 10101010 en el byte bajo
int: not_u = ~u
println("~170 = ", not_u)        // -171
println()

println("--- Shift izquierdo (<<) ---")
int: base = 1
println("1 << 0 = ", base << 0)   // 1
println("1 << 1 = ", base << 1)   // 2
println("1 << 2 = ", base << 2)   // 4
println("1 << 8 = ", base << 8)   // 256

int: val = 3
println("3 << 3 = ", val << 3)    // 24
println()

println("--- Shift derecho (>>) ---")
int: big = 256
println("256 >> 1 = ", big >> 1)  // 128
println("256 >> 4 = ", big >> 4)  // 16
println("256 >> 8 = ", big >> 8)  // 1

int: v = 100
println("100 >> 2 = ", v >> 2)    // 25
println()

println("--- Precedencia ---")
int: r1 = 1 | 2 & 3      // & antes que |: 1 | (2&3) = 1|2 = 3
int: r2 = 4 ^ 2 | 1      // ^ antes que |: (4^2)|1 = 6|1 = 7
int: r3 = 2 << 1 & 6     // << antes que &: (2<<1)&6 = 4&6 = 4
println("1 | 2 & 3 = ", r1)   // 3
println("4 ^ 2 | 1 = ", r2)   // 7
println("2 << 1 & 6 = ", r3)  // 4
println()

println("--- Bool bitwise ---")
bool: t = true
bool: f = false
println("true & false = ", t & f)   // false
println("true | false = ", t | f)   // true
println("true ^ true  = ", t ^ t)   // false
println("~true        = ", ~t)       // false
println()

println("Fin operadores bitwise")
