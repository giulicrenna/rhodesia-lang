// histogram.rho - Bins raw values and renders as bars.
// Uses vec of synthetic uniform samples (rand() * 10 - 5 -> values in [-5, 5]).

include plot

println("=== Histogram ===")

vec: samples = math.zeros(1000)
int: i = 0
while i < 1000 {
    samples[i] = rand() * 10.0 - 5.0
    i = i + 1
}

figure(800, 510)
hist(samples, 25, "samples", "steelblue")
title("Histogram of 1000 uniform samples in [-5, 5]")
xlabel("value")
ylabel("count")
legend(1)

int: bytes = savefig("histogram.svg")
println("Wrote ", bytes, " bytes to histogram.svg")