include plot
println("=== absolute_value ===")
fun f(float64: x) -> float64 { return math.abs(x) }
figure(800, 510)
plot(f, -3, 3, "f(x)", "blue")
title("absolute_value")
xlabel("x")
ylabel("f(x)")
legend(1)
int: bytes = savefig("absolute_value.svg")
println("Wrote ", bytes, " bytes to absolute_value.svg")
