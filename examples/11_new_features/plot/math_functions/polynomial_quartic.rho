include plot
println("=== polynomial_quartic ===")
fun f(float64: x) -> float64 { return x*x*x*x - 3*x*x + 1 }
figure(800, 510)
plot(f, -3, 3, "f(x)", "blue")
title("polynomial_quartic")
xlabel("x")
ylabel("f(x)")
legend(1)
int: bytes = savefig("polynomial_quartic.svg")
println("Wrote ", bytes, " bytes to polynomial_quartic.svg")
