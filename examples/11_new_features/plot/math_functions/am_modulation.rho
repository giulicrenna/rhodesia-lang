include plot
println("=== am_modulation ===")
fun f(float64: x) -> float64 { return math.cos(10 * x) * math.cos(x) }
figure(800, 510)
plot(f, 0, 10, "f(x)", "blue")
title("am_modulation")
xlabel("x")
ylabel("f(x)")
legend(1)
int: bytes = savefig("am_modulation.svg")
println("Wrote ", bytes, " bytes to am_modulation.svg")
