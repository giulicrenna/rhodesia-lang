include plot
println("=== gaussian ===")
fun f(float64: x) -> float64 { return math.exp(-x*x/2) / math.sqrt(2*math.PI) }
figure(800, 510)
plot(f, -4, 4, "f(x)", "blue")
title("gaussian")
xlabel("x")
ylabel("f(x)")
legend(1)
int: bytes = savefig("gaussian.svg")
println("Wrote ", bytes, " bytes to gaussian.svg")
