include plot
println("=== cosine_pulse ===")
fun f(float64: x) -> float64 { return math.cos(x) * math.cos(x) }
figure(800, 510)
plot(f, -6.283185, 6.283185, "f(x)", "blue")
title("cosine_pulse")
xlabel("x")
ylabel("f(x)")
legend(1)
int: bytes = savefig("cosine_pulse.svg")
println("Wrote ", bytes, " bytes to cosine_pulse.svg")
