include plot
println("=== damped_oscillation ===")
fun f(float64: x) -> float64 { return math.exp(-0.3 * x) * math.cos(2 * x) }
figure(800, 510)
plot(f, 0, 20, "f(x)", "blue")
title("damped_oscillation")
xlabel("x")
ylabel("f(x)")
legend(1)
int: bytes = savefig("damped_oscillation.svg")
println("Wrote ", bytes, " bytes to damped_oscillation.svg")
