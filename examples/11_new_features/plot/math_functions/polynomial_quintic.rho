include plot
println("=== polynomial_quintic ===")
fun f(float64: x) -> float64 { return x*x*x*x*x - 5*x*x*x + 4*x }
figure(800, 510)
plot(f, -3, 3, "f(x)", "blue")
title("polynomial_quintic")
xlabel("x")
ylabel("f(x)")
legend(1)
int: bytes = savefig("polynomial_quintic.svg")
println("Wrote ", bytes, " bytes to polynomial_quintic.svg")
