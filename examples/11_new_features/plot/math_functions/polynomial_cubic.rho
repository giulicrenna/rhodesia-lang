include plot
println("=== polynomial_cubic ===")
fun f(float64: x) -> float64 { return x*x*x - 2*x }
figure(800, 510)
plot(f, -3, 3, "f(x)", "blue")
title("polynomial_cubic")
xlabel("x")
ylabel("f(x)")
legend(1)
int: bytes = savefig("polynomial_cubic.svg")
println("Wrote ", bytes, " bytes to polynomial_cubic.svg")
