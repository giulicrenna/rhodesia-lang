
fun describir_http(int: codigo) -> str {
    match codigo {
        200 -> { return "OK" }
        201 -> { return "Created" }
        400 -> { return "Bad Request" }
        401 -> { return "Unauthorized" }
        403 -> { return "Forbidden" }
        404 -> { return "Not Found" }
        500 -> { return "Internal Server Error" }
        _   -> { return "Codigo desconocido" }
    }
    return ""
}

println(describir_http(200))   // OK
println(describir_http(404))   // Not Found
println(describir_http(418))   // Codigo desconocido

fun tipo_dia(str: dia) -> str {
    match dia {
        "lunes"    -> { return "inicio de semana" }
        "viernes"  -> { return "fin de semana laboral" }
        "sabado"   -> { return "fin de semana" }
        "domingo"  -> { return "fin de semana" }
        _          -> { return "dia laboral normal" }
    }
    return ""
}

println(tipo_dia("lunes"))    // inicio de semana
println(tipo_dia("martes"))   // dia laboral normal
println(tipo_dia("sabado"))   // fin de semana

fun evaluar(bool: aprobado) -> str {
    match aprobado {
        true  -> { return "Aprobado" }
        false -> { return "Reprobado" }
        _     -> { return "Sin datos" }
    }
    return ""
}

println(evaluar(true))   // Aprobado
println(evaluar(false))  // Reprobado

fun clasificar_nota(int: nota) -> str {
    match nota {
        10 -> { return "Sobresaliente perfecto" }
        9  -> { return "Sobresaliente" }
        8  -> { return "Notable" }
        7  -> { return "Bien" }
        6  -> { return "Suficiente" }
        5  -> { return "Aprobado justo" }
        _  -> {
            if nota < 5 {
                return "Suspenso"
            }
            return "Nota no reconocida"
        }
    }
    return ""
}

println(clasificar_nota(9))   // Sobresaliente
println(clasificar_nota(7))   // Bien
println(clasificar_nota(4))   // Suspenso

fun siguiente_estado(str: estado, str: evento) -> str {
    match estado {
        "idle" -> {
            match evento {
                "start"  -> { return "running" }
                "reset"  -> { return "idle" }
                _        -> { return "idle" }
            }
            return "idle"
        }
        "running" -> {
            match evento {
                "pause"  -> { return "paused" }
                "stop"   -> { return "idle" }
                "error"  -> { return "error" }
                _        -> { return "running" }
            }
            return "running"
        }
        "paused" -> {
            match evento {
                "resume" -> { return "running" }
                "stop"   -> { return "idle" }
                _        -> { return "paused" }
            }
            return "paused"
        }
        "error" -> {
            match evento {
                "reset"  -> { return "idle" }
                _        -> { return "error" }
            }
            return "error"
        }
        _ -> { return "desconocido" }
    }
    return "desconocido"
}

str: estado = "idle"
println("Estado:", estado)
estado = siguiente_estado(estado, "start")
println("Tras start:", estado)        // running
estado = siguiente_estado(estado, "pause")
println("Tras pause:", estado)        // paused
estado = siguiente_estado(estado, "resume")
println("Tras resume:", estado)       // running
estado = siguiente_estado(estado, "error")
println("Tras error:", estado)        // error
estado = siguiente_estado(estado, "reset")
println("Tras reset:", estado)        // idle

record: operacion = { tipo: "suma", a: 10, b: 20 }

fun ejecutar(record: op) -> int {
    match op.tipo {
        "suma"  -> { return op.a + op.b }
        "resta" -> { return op.a - op.b }
        "mul"   -> { return op.a * op.b }
        _ -> {
            println("Operacion no soportada:", op.tipo)
            return 0
        }
    }
    return 0
}

int: resultado = ejecutar(operacion)
println("Resultado de", operacion.tipo, ":", resultado)  // 30

fun procesar(str: valor) -> str {
    match valor {
        null -> { return "valor ausente" }
        ""   -> { return "cadena vacia" }
        _    -> { return valor }
    }
    return ""
}

println(procesar("hola"))  // hola
println(procesar(""))      // cadena vacia
