// descriptive.rho
// Descriptive statistics functions

// Mean (average)
fun mean(vec: data) -> float64 {
    return sum(data) / float64(size(data))
}

// Variance (population)
fun variance(vec: data) -> float64 {
    float64: m = mean(data)
    vec: centered = data - m
    vec: squared = centered * centered
    return sum(squared) / float64(size(data))
}

// Standard deviation (population)
fun std_dev(vec: data) -> float64 {
    return sqrt(variance(data))
}

// Sample variance (unbiased estimator)
fun sample_variance(vec: data) -> float64 {
    if size(data) <= 1 {
        return 0.0
    }
    float64: m = mean(data)
    vec: centered = data - m
    vec: squared = centered * centered
    return sum(squared) / float64(size(data) - 1)
}

// Sample standard deviation
fun sample_std_dev(vec: data) -> float64 {
    return sqrt(sample_variance(data))
}

// Median
fun median(vec: data) -> float64 {
    vec: sorted = vec_sort(data)
    int: n = size(sorted)

    if n % 2 == 1 {
        return sorted[n / 2]
    } else {
        return (sorted[n / 2 - 1] + sorted[n / 2]) / 2.0
    }
}

// Mode (most frequent value)
fun mode(vec: data) -> float64 {
    int: n = size(data)
    float64: current_mode = data[0]
    int: max_count = 1

    for i in range(n) {
        int: count = 1
        for j in range(i + 1, n) {
            if data[i] == data[j] {
                count = count + 1
            }
        }

        if count > max_count {
            max_count = count
            current_mode = data[i]
        }
    }

    return current_mode
}

// Range (max - min)
fun range(vec: data) -> float64 {
    return max_value(data) - min_value(data)
}

// Interquartile range (IQR)
fun iqr(vec: data) -> float64 {
    vec: sorted = vec_sort(data)
    int: n = size(sorted)

    int: q1_index = n / 4
    int: q3_index = 3 * n / 4

    float64: q1 = sorted[q1_index]
    float64: q3 = sorted[q3_index]

    return q3 - q1
}

// Skewness (measure of asymmetry)
fun skewness(vec: data) -> float64 {
    float64: m = mean(data)
    float64: std = std_dev(data)
    int: n = size(data)

    if std == 0.0 {
        return 0.0
    }

    float64: sum_cubed = 0.0
    for i in range(n) {
        float64: diff = data[i] - m
        sum_cubed = sum_cubed + diff * diff * diff
    }

    return (sum_cubed / float64(n)) / (std * std * std)
}

// Kurtosis (measure of "tailedness")
fun kurtosis(vec: data) -> float64 {
    float64: m = mean(data)
    float64: std = std_dev(data)
    int: n = size(data)

    if std == 0.0 {
        return 0.0
    }

    float64: sum_quad = 0.0
    for i in range(n) {
        float64: diff = data[i] - m
        sum_quad = sum_quad + diff * diff * diff * diff
    }

    return (sum_quad / float64(n)) / (std * std * std * std) - 3.0
}

// Coefficient of variation (relative standard deviation)
fun coefficient_of_variation(vec: data) -> float64 {
    float64: m = mean(data)
    float64: std = std_dev(data)

    if m == 0.0 {
        return 0.0
    }

    return std / m
}

// Percentile calculation
fun percentile(vec: data, float64: p) -> float64 {
    vec: sorted = vec_sort(data)
    int: n = size(sorted)
    float64: index = p * float64(n - 1)

    int: lower_index = int(index)
    int: upper_index = min(lower_index + 1, n - 1)
    float64: fraction = index - float64(lower_index)

    if lower_index == upper_index {
        return sorted[lower_index]
    }

    return sorted[lower_index] + fraction * (sorted[upper_index] - sorted[lower_index])
}

// Quartiles
fun quartiles(vec: data) -> vec {
    return [
        percentile(data, 0.25),
        percentile(data, 0.50),
        percentile(data, 0.75)
    ]
}

// Covariance between two vectors
fun covariance(vec: x, vec: y) -> float64 {
    int: n = size(x)
    float64: mean_x = mean(x)
    float64: mean_y = mean(y)

    float64: sum = 0.0
    for i in range(n) {
        sum = sum + (x[i] - mean_x) * (y[i] - mean_y)
    }

    return sum / float64(n)
}

// Correlation coefficient (Pearson)
fun correlation(vec: x, vec: y) -> float64 {
    float64: cov = covariance(x, y)
    float64: std_x = std_dev(x)
    float64: std_y = std_dev(y)

    if std_x == 0.0 || std_y == 0.0 {
        return 0.0
    }

    return cov / (std_x * std_y)
}

// Z-score normalization
fun z_score_normalize(vec: data) -> vec {
    float64: m = mean(data)
    float64: std = std_dev(data)
    int: n = size(data)
    vec: normalized = zeros(n)

    if std == 0.0 {
        return normalized  // Return zeros if std dev is 0
    }

    for i in range(n) {
        normalized[i] = (data[i] - m) / std
    }

    return normalized
}

// Min-max normalization (scaling to [0, 1] range)
fun min_max_normalize(vec: data) -> vec {
    float64: min_val = min_value(data)
    float64: max_val = max_value(data)
    float64: range_val = max_val - min_val
    int: n = size(data)
    vec: normalized = zeros(n)

    if range_val == 0.0 {
        return normalized  // Return zeros if range is 0
    }

    for i in range(n) {
        normalized[i] = (data[i] - min_val) / range_val
    }

    return normalized
}

// Helper function: sort vector (simple bubble sort)
fun vec_sort(vec: data) -> vec {
    int: n = size(data)
    vec: sorted = zeros(n)

    // Copy data
    for i in range(n) {
        sorted[i] = data[i]
    }

    // Bubble sort
    for i in range(n) {
        for j in range(i + 1, n) {
            if sorted[i] > sorted[j] {
                float64: temp = sorted[i]
                sorted[i] = sorted[j]
                sorted[j] = temp
            }
        }
    }

    return sorted
}

// Helper function: find minimum value
fun min_value(vec: data) -> float64 {
    float64: min_val = data[0]
    int: n = size(data)

    for i in range(1, n) {
        if data[i] < min_val {
            min_val = data[i]
        }
    }

    return min_val
}

// Helper function: find maximum value
fun max_value(vec: data) -> float64 {
    float64: max_val = data[0]
    int: n = size(data)

    for i in range(1, n) {
        if data[i] > max_val {
            max_val = data[i]
        }
    }

    return max_val
}
