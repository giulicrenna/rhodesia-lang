// probability.rho
// Probability distribution functions

// Normal distribution PDF (Probability Density Function)
fun normal_pdf(float64: x, float64: mean, float64: std_dev) -> float64 {
    float64: exponent = -0.5 * power((x - mean) / std_dev, 2)
    float64: coeff = 1.0 / (std_dev * sqrt(2.0 * PI))
    return coeff * exp(exponent)
}

// Normal distribution CDF approximation (using error function approximation)
fun normal_cdf(float64: x, float64: mean, float64: std_dev) -> float64 {
    float64: z = (x - mean) / std_dev
    return 0.5 * (1.0 + erf_approx(z))
}

// Error function approximation
fun erf_approx(float64: x) -> float64 {
    // Simple approximation of the error function
    float64: abs_x = abs(x)
    float64: t = 1.0 / (1.0 + 0.3275911 * abs_x)

    float64: a1 = 0.254829592
    float64: a2 = -0.284496736
    float64: a3 = 1.421413741
    float64: a4 = -1.453152027
    float64: a5 = 1.061405429

    float64: poly = 1.0 + a1 * t + a2 * t * t + a3 * t * t * t + a4 * t * t * t * t + a5 * t * t * t * t * t
    float64: result = 1.0 - poly * exp(-x * x)

    if x < 0.0 {
        result = -result
    }

    return result
}

// Standard normal distribution PDF (mean=0, std_dev=1)
fun standard_normal_pdf(float64: x) -> float64 {
    return normal_pdf(x, 0.0, 1.0)
}

// Standard normal distribution CDF
fun standard_normal_cdf(float64: x) -> float64 {
    return normal_cdf(x, 0.0, 1.0)
}

// Uniform distribution PDF
fun uniform_pdf(float64: x, float64: a, float64: b) -> float64 {
    if x < a || x > b {
        return 0.0
    }
    return 1.0 / (b - a)
}

// Uniform distribution CDF
fun uniform_cdf(float64: x, float64: a, float64: b) -> float64 {
    if x < a {
        return 0.0
    }
    if x > b {
        return 1.0
    }
    return (x - a) / (b - a)
}

// Exponential distribution PDF
fun exponential_pdf(float64: x, float64: rate) -> float64 {
    if x < 0.0 {
        return 0.0
    }
    return rate * exp(-rate * x)
}

// Exponential distribution CDF
fun exponential_cdf(float64: x, float64: rate) -> float64 {
    if x < 0.0 {
        return 0.0
    }
    return 1.0 - exp(-rate * x)
}

// Poisson distribution PMF (Probability Mass Function)
fun poisson_pmf(int: k, float64: lambda) -> float64 {
    return power(lambda, k) * exp(-lambda) / factorial(k)
}

// Poisson distribution CDF (approximate)
fun poisson_cdf(int: k, float64: lambda) -> float64 {
    float64: sum = 0.0
    for i in range(k + 1) {
        sum = sum + poisson_pmf(i, lambda)
    }
    return sum
}

// Binomial distribution PMF
fun binomial_pmf(int: k, int: n, float64: p) -> float64 {
    return binomial_coefficient(n, k) * power(p, k) * power(1.0 - p, n - k)
}

// Binomial distribution CDF (approximate)
fun binomial_cdf(int: k, int: n, float64: p) -> float64 {
    float64: sum = 0.0
    for i in range(k + 1) {
        sum = sum + binomial_pmf(i, n, p)
    }
    return sum
}

// Binomial coefficient (n choose k)
fun binomial_coefficient(int: n, int: k) -> float64 {
    if k < 0 || k > n {
        return 0.0
    }
    if k == 0 || k == n {
        return 1.0
    }

    // Use multiplicative formula to avoid large factorials
    float64: result = 1.0
    int: smaller_k = min(k, n - k)

    for i in range(smaller_k) {
        result = result * float64(n - i) / float64(i + 1)
    }

    return result
}

// Gamma function approximation (Lanczos approximation)
fun gamma_approx(float64: x) -> float64 {
    // Simple approximation for positive x
    if x <= 0.0 {
        return 0.0  // Gamma function undefined for non-positive integers
    }

    // Coefficients for Lanczos approximation
    vec: p = [
        676.5203681218851,
        -1259.1392167224028,
        771.32342877765313,
        -176.61502916214059,
        12.507343278686905,
        -0.13857109526572012,
        9.9843695780195716e-6,
        1.5056327351493116e-7
    ]

    float64: g = 7.0
    float64: z = x

    if x < 0.5 {
        return PI / (sin_taylor(PI * x, 10) * gamma_approx(1.0 - x))
    }

    z = x - 1.0
    float64: x_tilde = z + g + 0.5
    float64: sum = 0.0

    for i in range(8) {
        sum = sum + p[i] / (z + float64(i) + 1.0)
    }

    float64: t = z + g + 0.5
    float64: result = sqrt(2.0 * PI) * power(t, z + 0.5) * exp(-t) * sum

    return result
}

// Beta function using gamma function
fun beta_function(float64: alpha, float64: beta) -> float64 {
    return gamma_approx(alpha) * gamma_approx(beta) / gamma_approx(alpha + beta)
}

// Chi-squared distribution PDF
fun chisquare_pdf(float64: x, int: k) -> float64 {
    if x <= 0.0 {
        return 0.0
    }
    float64: coeff = 1.0 / (power(2.0, float64(k)/2.0) * gamma_approx(float64(k)/2.0))
    return coeff * power(x, float64(k)/2.0 - 1.0) * exp(-x / 2.0)
}

// Student's t-distribution PDF
fun student_t_pdf(float64: x, int: df) -> float64 {
    float64: coeff = gamma_approx((float64(df) + 1.0) / 2.0) /
                    (sqrt(float64(df) * PI) * gamma_approx(float64(df) / 2.0))
    return coeff * power(1.0 + x * x / float64(df), -(float64(df) + 1.0) / 2.0)
}

// Inverse CDF (quantile function) for standard normal (approximate)
fun standard_normal_quantile(float64: p) -> float64 {
    // Simple approximation for p in (0, 1)
    if p <= 0.0 || p >= 1.0 {
        return 0.0  // Handle edge cases
    }

    // Coefficients for Beasley-Springer approximation
    vec: a = [-3.969683028665376e+01,  2.209460984245205e+02,
              -2.759285104469687e+02,  1.383577518672690e+02,
              -3.066479806614716e+01,  2.506628277459239e+00]

    vec: b = [-5.447609879822406e+01,  1.615858368580409e+02,
              -1.556989798598866e+02,  6.680131188771972e+01,
              -1.328068155288572e+01]

    vec: c = [-7.784894002430293e-03, -3.223964580411365e-01,
              -2.400758277161838e+00, -2.549732539343734e+00,
              4.374664141464968e+00,  2.938163982698783e+00]

    vec: d = [7.784695709041462e-03, 3.224671290700398e-01,
              2.445134137142996e+00,  3.754408661907416e+00]

    float64: q = p - 0.5
    float64: r = 0.0

    if abs(q) <= 0.425 {
        r = q * q
        return q * (((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) /
               (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1.0)
    } else {
        r = p
        if q > 0.0 {
            r = 1.0 - p
        }
        r = sqrt(-log(r))

        if r <= 5.0 {
            r = r - 1.6
            return (((((c[0] * r + c[1]) * r + c[2]) * r + c[3]) * r + c[4]) * r + c[5]) /
                   (((((d[0] * r + d[1]) * r + d[2]) * r + d[3]) * r + 1.0)
        } else {
            r = r - 5.0
            return (((((c[0] * r + c[1]) * r + c[2]) * r + c[3]) * r + c[4]) * r + c[5]) /
                   (((((d[0] * r + d[1]) * r + d[2]) * r + d[3]) * r + 1.0)
        }
    }
}
