// ============================================================================
// data_science.rho - Complete Data Science Example
// Demonstrates a typical ML workflow in Rhodesia
// ============================================================================

println("========================================")
println("  Data Science Pipeline with Rhodesia")
println("========================================")
println("")

// ============================================================================
// 1. DATA PREPARATION
// ============================================================================
println("1. Data Preparation")
println("-------------------")

// Simulated dataset: Features (X) and targets (y)
// Features: [intercept, x1, x2]
mat: X = [
    [1.0, 2.3, 4.5],
    [1.0, 3.1, 2.2],
    [1.0, 4.8, 5.1],
    [1.0, 1.9, 3.8],
    [1.0, 5.2, 1.9],
    [1.0, 3.7, 4.2],
    [1.0, 2.8, 3.1],
    [1.0, 4.1, 5.6],
    [1.0, 3.3, 2.9],
    [1.0, 5.8, 4.8]
]

vec: y = [15.2, 12.8, 21.3, 13.5, 17.9, 18.4, 14.6, 22.1, 15.7, 24.2]

int: n_samples = math.rows(X)
int: n_features = math.cols(X)

println("Dataset shape: ", n_samples, " x ", n_features)
println("Target size: ", math.size(y))
println("")

// ============================================================================
// 2. TRAIN/TEST SPLIT (manual 80/20)
// ============================================================================
println("2. Train/Test Split (80/20)")
println("---------------------------")

// First 8 samples for training, last 2 for testing
mat: X_train = [
    [1.0, 2.3, 4.5],
    [1.0, 3.1, 2.2],
    [1.0, 4.8, 5.1],
    [1.0, 1.9, 3.8],
    [1.0, 5.2, 1.9],
    [1.0, 3.7, 4.2],
    [1.0, 2.8, 3.1],
    [1.0, 4.1, 5.6]
]

vec: y_train = [15.2, 12.8, 21.3, 13.5, 17.9, 18.4, 14.6, 22.1]

mat: X_test = [
    [1.0, 3.3, 2.9],
    [1.0, 5.8, 4.8]
]

vec: y_test = [15.7, 24.2]

println("Training samples: ", math.rows(X_train))
println("Test samples: ", math.rows(X_test))
println("")

// ============================================================================
// 3. MODEL TRAINING (OLS)
// ============================================================================
println("3. Model Training (Ordinary Least Squares)")
println("------------------------------------------")

fun fit_ols(mat: X, vec: y) -> vec {
    mat: xt = math.transpose(X)
    mat: xtx = xt * X
    mat: xtx_inv = math.inv(xtx)
    vec: xty = xt * y
    return xtx_inv * xty
}

vec: weights = fit_ols(X_train, y_train)

println("Learned weights:")
println("  w0 (intercept): ", weights[0])
println("  w1 (feature 1): ", weights[1])
println("  w2 (feature 2): ", weights[2])
println("")

// ============================================================================
// 4. PREDICTIONS
// ============================================================================
println("4. Predictions")
println("--------------")

fun predict(mat: X, vec: w) -> vec {
    return X * w
}

vec: y_train_pred = predict(X_train, weights)
vec: y_test_pred = predict(X_test, weights)

println("Training predictions:")
for i in range(math.size(y_train)) {
    print("  actual: ")
    print(y_train[i])
    print("  predicted: ")
    println(y_train_pred[i])
}
println("")

println("Test predictions:")
for i in range(math.size(y_test)) {
    print("  actual: ")
    print(y_test[i])
    print("  predicted: ")
    println(y_test_pred[i])
}
println("")

// ============================================================================
// 5. MODEL EVALUATION
// ============================================================================
println("5. Model Evaluation")
println("-------------------")

// Mean Squared Error
fun mse(vec: y_true, vec: y_pred) -> float64 {
    vec: diff = y_true - y_pred
    return math.dot(diff, diff) / math.size(y_true)
}

// Root Mean Squared Error
fun rmse(vec: y_true, vec: y_pred) -> float64 {
    return math.sqrt(mse(y_true, y_pred))
}

// Mean Absolute Error
fun mae(vec: y_true, vec: y_pred) -> float64 {
    vec: diff = y_true - y_pred
    return math.sum(math.abs(diff)) / math.size(y_true)
}

// R-squared
fun r_squared(vec: y_true, vec: y_pred) -> float64 {
    vec: residuals = y_true - y_pred
    float64: ss_res = math.dot(residuals, residuals)

    float64: y_mean = math.mean(y_true)
    vec: y_centered = y_true - y_mean * math.ones(math.size(y_true))
    float64: ss_tot = math.dot(y_centered, y_centered)

    return 1.0 - ss_res / ss_tot
}

println("Training metrics:")
println("  MSE:  ", mse(y_train, y_train_pred))
println("  RMSE: ", rmse(y_train, y_train_pred))
println("  MAE:  ", mae(y_train, y_train_pred))
println("  R²:   ", r_squared(y_train, y_train_pred))
println("")

println("Test metrics:")
println("  MSE:  ", mse(y_test, y_test_pred))
println("  RMSE: ", rmse(y_test, y_test_pred))
println("  MAE:  ", mae(y_test, y_test_pred))
println("  R²:   ", r_squared(y_test, y_test_pred))
println("")

// ============================================================================
// 6. FEATURE IMPORTANCE (normalized weights)
// ============================================================================
println("6. Feature Importance")
println("---------------------")

// Compute absolute weights (skip intercept)
float64: w1_abs = math.abs(weights[1])
float64: w2_abs = math.abs(weights[2])
float64: total = w1_abs + w2_abs

println("Relative importance:")
println("  Feature 1: ", w1_abs / total * 100, "%")
println("  Feature 2: ", w2_abs / total * 100, "%")
println("")

println("========================================")
println("  Pipeline Complete!")
println("========================================")
