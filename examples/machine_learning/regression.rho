// ============================================================================
// regression.rho - Linear Regression Example
// Demonstrates OLS regression with Rhodesia
// ============================================================================

println("=== Linear Regression with Rhodesia ===")
println("")

// Design matrix: each row is [1, x] for intercept + slope
mat: X = [
    [1.0, 1.0],
    [1.0, 2.0],
    [1.0, 3.0],
    [1.0, 4.0],
    [1.0, 5.0],
    [1.0, 6.0],
    [1.0, 7.0],
    [1.0, 8.0]
]

// Response variable (approximately y = 0.5 + 2*x + noise)
vec: y = [2.3, 4.1, 6.8, 8.5, 10.2, 12.9, 14.1, 16.4]

println("Design Matrix X:")
println(X)
println("")
println("Response vector y:")
println(y)
println("")

// OLS Estimator: β = (X'X)^(-1) X'y
fun ols_fit(mat: X, vec: y) -> vec {
    mat: xt = transpose(X)
    mat: xtx = xt * X
    mat: xtx_inv = inv(xtx)
    vec: xty = xt * y
    vec: beta = xtx_inv * xty
    return beta
}

// Compute coefficients
vec: beta = ols_fit(X, y)

println("=== OLS Results ===")
println("Intercept (beta_0):", beta[0])
println("Slope (beta_1):    ", beta[1])
println("")

// Compute predictions
vec: y_pred = X * beta

println("=== Predictions ===")
println("Actual     Predicted")
for i in range(size(y)) {
    print(y[i])
    print("       ")
    println(y_pred[i])
}
println("")

// R-squared calculation
float64: y_mean = mean(y)
vec: residuals = y - y_pred
vec: y_centered = y - y_mean * ones(size(y))

float64: ss_res = dot(residuals, residuals)
float64: ss_tot = dot(y_centered, y_centered)
float64: r_squared = 1.0 - ss_res / ss_tot

println("=== Model Quality ===")
println("Sum of Squared Residuals:", ss_res)
println("Total Sum of Squares:    ", ss_tot)
println("R-squared:               ", r_squared)
println("")

// RMSE
float64: rmse = sqrt(ss_res / size(y))
println("RMSE:                    ", rmse)
