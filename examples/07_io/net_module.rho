// Módulo net: sockets TCP y cliente HTTP/1.1

println("net: HTTP")
println()


// HTTP GET básico

println("--- net.http_get ---")

record: resp = net.http_get("http://httpbin.org/get")
println("Status: ", resp.status)
println("Status text: ", resp.status_text)
println("Body (primeros 200 chars): ", string.slice(resp.body, 0, 200))
println()

// Acceder a un header de la respuesta
str: content_type = mapping.get(resp.headers, "content-type")
println("Content-Type: ", content_type)
println()


// HTTP POST con body

println("--- net.http_post ---")

record: post_resp = net.http_post("http://httpbin.org/post", "campo=valor&otro=123")
println("Status POST: ", post_resp.status)
println()


// net.http_request: método arbitrario con headers personalizados

println("--- net.http_request (PUT con JSON) ---")

map: headers = mapping.create()
mapping.put(headers, "Content-Type", "application/json")
mapping.put(headers, "Accept", "application/json")

str: json_body = "{\"nombre\": \"Rhodesia\", \"version\": 1}"
record: put_resp = net.http_request("PUT", "http://httpbin.org/put", json_body, headers)
println("Status PUT: ", put_resp.status)
println()


// A Ntfy

fun sendNtfy(str: message, str: title, str: tags) -> record {
    map: headers = mapping.create()
    mapping.put(headers, "Title", title)
    mapping.put(headers, "Priority", "high")
    mapping.put(headers, "Tags", tags)

    str: ntfy_url = "http://ntfy.sh/terralytics-alerts"

    return net.http_request("POST", ntfy_url, message, headers)
}

record: post_resp_2 = sendNtfy("Esta es una prueba automatizada.", "Rhodesia", "warning")

println("Status POST ntfy: ", post_resp_2.status)
println()


// ntfy permite personalizar la notificación a través de los headers



// Socket TCP crudo (cliente)

println("--- net.socket / connect / send / recv_all ---")

int: sock = net.socket("httpbin.org", 80)
bool: ok = net.connect(sock)
println("Conectado: ", ok)

if ok {
    str: request = "GET /ip HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n"
    int: sent = net.send(sock, request)
    println("Bytes enviados: ", sent)

    str: raw = net.recv_all(sock)
    println("Respuesta cruda (primeros 300):")
    println(string.slice(raw, 0, 300))
}

net.close(sock)
println()


